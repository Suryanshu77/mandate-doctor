# Mandate Doctor — environment template.
#
# Copy this file to `.env` at the repository root and fill in values.
# Never commit real secret values.

# RazoRAY test-mode webhook verification secret.
# Optional for a basic local run — the backend starts and serves /api/*
# and /health fine without it. Webhook ingestion returns
# "server_not_configured" until a secret is provided.
RAZORPAY_WEBHOOK_SECRET=

# ---- LLM-assisted recovery proposal layer (server-side only) ----
# The LLM only PROPOSES a recovery intervention; the deterministic policy
# engine still decides and the action layer executes only when allowed.
# All values are optional placeholders: leave LLM_API_KEY empty and the
# proposal layer runs fully on the existing deterministic logic (the app
# works with no LLM and no network access). Never commit a real key.
AI_PROPOSAL_ENABLED=true
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=10
